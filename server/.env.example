# Порт HTTP-сервера (фронтенд обращается к http://localhost:3000)
PORT=3000

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shop_online

# Товаров на одной странице пагинации
LIMIT=10

# Максимальный размер тела запроса в байтах (base64-изображения)
MAX_BODY_SIZE=2097152

# Каталог для изображений товаров (по умолчанию server/image)
# IMAGE_DIR=./image
